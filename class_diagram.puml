' REST API UML Profile: Application -> Path -> Resource -> Representation.
' Operations use the real controller export names; return types describe payload data.
@startuml HotelBookingAuthApi
!pragma layout smetana
left to right direction
title Hotel Booking - Authentication API (UML Profile)
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members
package HotelBooking {
  class HotelBookingService <<Application>> #FFF2CC
  class Auth <<Resource>> #D9EAD3
  class Register <<Resource>> #D9EAD3 {
    +register() : AuthResponse <<POST>>
  }
  class Login <<Resource>> #D9EAD3 {
    +login() : AuthResponse <<POST>>
  }
  class Me <<Resource>> #D9EAD3 {
    +getMe() : User <<GET>>
  }
  class Logout <<Resource>> #D9EAD3 {
    +logout() : EmptyResponse <<GET>>
  }
  class AuthResponse <<Representation>> #D9EAD3 {
    +success : Boolean
    +_id : ObjectId
    +name : String
    +email : String
    +tel : String
    +role : String
    +token : String
  }
  class User <<Representation>> #D9EAD3 {
    +_id : ObjectId
    +name : String
    +email : String
    +tel : String
    +role : String
    +createdAt : Date
  }
  HotelBookingService ..> Auth : /api/v1/auth\n<<Path>>
  Auth ..> Register : /register\n<<Path>>
  Auth ..> Login : /login\n<<Path>>
  Auth ..> Me : /me\n<<Path>>
  Auth ..> Logout : /logout\n<<Path>>
  Register ..> AuthResponse : <<use>>
  Login ..> AuthResponse : <<use>>
  Me ..> User : <<use>>
}
note bottom of Register
  Body: name, tel (or telephoneNumber), email, password; role is accepted.
  200: token issued; 400: registration/validation failure.
end note
note bottom of Me
  Bearer JWT required. Response: {success, data: User}.
  Password is excluded by the User model.
end note
note bottom of Logout
  Public route; clears token cookie (200).
  Existing Bearer JWT is not revoked.
end note
legend bottom
  Path labels concatenate from the Application to the selected Resource.
  HTTP stereotypes identify methods; operations match controllers/auth.js.
endlegend
@enduml

@startuml HotelBookingHotelsApi
!pragma layout smetana
left to right direction
title Hotel Booking - Hotels API (UML Profile)
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members
package HotelBooking {
  class HotelBookingService <<Application>> #FFF2CC
  class Hotels <<Resource>> #D9EAD3 {
    +getHotels() : Hotel[] <<GET>>
    +createHotel() : Hotel <<POST>>
  }
  class HotelResource <<Resource>> #D9EAD3 {
    +getHotel() : Hotel <<GET>>
    +updateHotel() : Hotel <<PUT>>
    +deleteHotel() : EmptyResponse <<DELETE>>
  }
  class HotelsInRadius <<Resource>> #D9EAD3 {
    +getHotelsInRadius() : Hotel[] <<GET>>
  }
  class Hotel <<Representation>> #D9EAD3 {
    +_id : ObjectId
    +name : String
    +address : String
    +district : String
    +province : String
    +postalcode : String
    +tel : String
    +region : String
    +location : GeoJSONPoint
    +pricePerNight : Number
    +taxId : String
  }
  HotelBookingService ..> Hotels : /api/v1/hotels\n<<Path>>
  Hotels ..> HotelResource : /{id}\n<<Path>>
  Hotels ..> HotelsInRadius : /radius/{lat}/{lng}/{distance}\n<<Path>>
  Hotels ..> Hotel : <<use>>
  HotelResource ..> Hotel : <<use>>
  HotelsInRadius ..> Hotel : <<use>>
}
note bottom of Hotels
  GET is public. POST requires Bearer JWT + admin role.
  List: {success, count, pagination, data: Hotel[]}.
  Supports select, sort, page, limit and field filters.
  Optional radius query: ?lat=...&lng=...&distance=... (km).
  Public responses do not populate user bookings.
end note
note bottom of HotelResource
  GET is public; PUT/DELETE require admin.
  Single/create/update: {success, data: Hotel}.
  DELETE removes associated bookings, then the hotel.
end note
note bottom of HotelsInRadius
  Public; distance in kilometers.
  Uses MongoDB $geoWithin / $centerSphere.
  Response: {success, count, data: Hotel[]}.
end note
@enduml

@startuml HotelBookingBookingsApi
!pragma layout smetana
left to right direction
title Hotel Booking - Bookings API (UML Profile)
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members
package HotelBooking {
  class HotelBookingService <<Application>> #FFF2CC
  class Bookings <<Resource>> #D9EAD3 {
    +getBookings() : Booking[] <<GET>>
    +addBooking() : Booking <<POST>>
  }
  class BookingResource <<Resource>> #D9EAD3 {
    +getBooking() : Booking <<GET>>
    +updateBooking() : Booking <<PUT>>
    +deleteBookings() : EmptyResponse <<DELETE>>
  }
  class Invoice <<Resource>> #D9EAD3 {
    +downloadInvoice() : PDF <<GET>>
  }
  class CronTrigger <<Resource>> #D9EAD3 {
    +triggerCronJob() : CronResult <<POST>>
  }
  class Booking <<Representation>> #D9EAD3 {
    +_id : ObjectId
    +checkInDate : Date
    +checkOutDate : Date
    +nights : Integer {1..3}
    +status : String
    +transactionRef : String
    +reminderEmailSent : Boolean
    +user : ObjectId or User
    +hotel : ObjectId or Hotel
    +createdAt : Date
  }
  class PDF <<Representation>> #D9EAD3 {
    +contentType : application/pdf
    +contentDisposition : attachment
    +body : Binary
  }
  class CronResult <<Representation>> #D9EAD3 {
    +success : Boolean
    +transitionedCount : Integer [on success]
    +remindersSentCount : Integer [on success]
    +error : String [on failure]
  }
  HotelBookingService ..> Bookings : /api/v1/bookings\n<<Path>>
  Bookings ..> BookingResource : /{id}\n<<Path>>
  BookingResource ..> Invoice : /invoice\n<<Path>>
  Bookings ..> CronTrigger : /trigger-cron\n<<Path>>
  Bookings ..> Booking : <<use>>
  BookingResource ..> Booking : <<use>>
  Invoice ..> PDF : <<use>>
  CronTrigger ..> CronResult : <<use>>
}
note bottom of Bookings
  Bearer JWT required. POST: user/admin; 201 on creation.
  GET: users see own bookings; admins see all.
  List response: {success, count, data: Booking[]}.
  Single/create/update response: {success, data: Booking}.
  Router is also mounted at /api/v1/hotels/{hotelId}/bookings.
  Nested list/create scopes by hotelId; item actions use id only.
end note
note bottom of BookingResource
  Owner or admin only (401 for ownership failure).
  Update recalculates check-out when date/nights change.
  DELETE physically removes a booking; no refund policy exists.
end note
note bottom of Invoice
  Owner/admin and Completed status required.
  Includes cost breakdown, tax ID and transaction reference.
end note
note bottom of CronTrigger
  Admin only; runs the same tasks as the scheduler.
  Scheduler is an internal job, not an HTTP resource.
end note
@enduml

@startuml HotelBookingDomainClasses
!pragma layout smetana
title Hotel Booking - Model Class Diagram

skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty methods

class User <<Mongoose model>> {
  +_id : ObjectId
  +name : String {required}
  +email : String {required, unique, email format}
  +tel : String {required, trim}
  +role : UserRole = user
  +password : String {required, minlength 6, select false}
  +resetPasswordToken : String [0..1]
  +resetPasswordExpire : Date [0..1]
  +createdAt : Date = now
  --
  +getSignedJwtToken() : String
  +matchPassword(enteredPassword) : Promise<Boolean>
}

class Hotel <<Mongoose model>> {
  +_id : ObjectId
  +name : String {required, unique, trim, maxLength 50}
  +address : String {required}
  +district : String {required}
  +province : String {required}
  +postalcode : String {required, maxLength 5}
  +tel : String {required, trim}
  +region : String {required}
  +location : GeoPoint [0..1]
  +pricePerNight : Number = 1500
  +taxId : String = "0105559876543"
  +/bookings : Booking [0..*] {virtual}
}

class GeoPoint <<embedded value>> {
  +type : String {Point}
  +coordinates : Number [0..*]
  +formattedAddress : String [0..1]
}

class Booking <<Mongoose model>> {
  +_id : ObjectId
  +checkInDate : Date {required}
  +checkOutDate : Date [0..1]
  +nights : Number {required, integer, 1..3}
  +status : BookingStatus = Confirmed
  +transactionRef : String [0..1] {unique, sparse}
  +reminderEmailSent : Boolean = false
  +user : ObjectId {required, ref User}
  +hotel : ObjectId {required, ref Hotel}
  +createdAt : Date = now
}

enum UserRole {
  user
  admin
}

enum BookingStatus {
  Confirmed
  Completed
  Cancelled
  No-Show
}

User "1" -- "0..*" Booking : owns
Hotel "1" -- "0..*" Booking : receives
Hotel "1" *-- "0..1" GeoPoint : location
User ..> UserRole : role values
Booking ..> BookingStatus : status values

note left of User
  Pre-save hook hashes the password using bcrypt.
  JWT contains the user ID and uses JWT_EXPIRE.
  Admin is represented by role = admin.
end note

note right of Hotel
  location has a 2dsphere index.
  GeoJSON coordinates use [longitude, latitude].
  /bookings is populated through Booking.hotel.
end note

note bottom of Booking
  Pre-save hook calculates checkOutDate from checkInDate + nights.
  Generates transactionRef when absent.
  Each booking references one user and one hotel.
  Every booking is limited to 1-3 nights.
end note

legend bottom
  [0..1] optional field | {required} required field | /field virtual field
  Solid line = model association | Filled diamond = embedded value
  Dotted arrow = dependency | Multiplicity follows schema references
endlegend
@enduml
