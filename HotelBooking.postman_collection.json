              "raw": "{\n  \"checkInDate\": \"{{CHECK_IN_DATE}}\",\n  \"nights\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Start the Bookings folder here after Login. When HOTEL_ID is empty, the pre-request script fetches the first existing hotel and saves its ID automatically. A supplied HOTEL_ID is preserved. Clear the previous BOOKING_ID, create a new booking and save response.data._id to the collection variable BOOKING_ID automatically. Runner: Add Booking -> Get Single Booking -> Update Booking -> Get All Bookings -> Get Bookings for Hotel -> Delete Booking -> stop. CHECK_IN_DATE defaults to 10 days ahead only when empty. Creation failure stops the run without using an old ID."
          },
          "response": []
        },
        {
          "name": "Get Single Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response below 3 seconds', () => pm.expect(pm.response.responseTime).to.be.below(3000));",
                  "pm.test('Success response', () => pm.expect(pm.response.json().success).to.be.true);",
                  "",
                  "pm.test('Returns the created booking', () => pm.expect(pm.response.json().data._id).to.eql(pm.collectionVariables.get('BOOKING_ID')));",
                  "",
                  "// Runner flow (like VacQ)",
                  "let runnerOK = pm.response.code === 200;",
                  "if (runnerOK) {",
                  "  try { runnerOK = pm.response.json().success === true; } catch (err) { runnerOK = false; }",
