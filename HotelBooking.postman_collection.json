                  "if (runnerOK) runnerOK = !!pm.collectionVariables.get('BOOKING_ID') && pm.response.json().data._id === pm.collectionVariables.get('BOOKING_ID');",
                  "pm.execution.setNextRequest(runnerOK ? \"Update Booking\" : null);"
