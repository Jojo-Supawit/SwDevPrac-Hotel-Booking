                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Geospatial radius returns hotels and excludes distant Pattaya hotel\", function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.success).to.be.true;",
                  "    pm.expect(res.count).to.be.above(0);",
                  "    pm.expect(Array.isArray(res.data)).to.be.true;",
                  "    const hasPattaya = res.data.some(h => (h.province && h.province.includes(\"Chonburi\")) || (h.name && h.name.includes(\"Pattaya\")));",
