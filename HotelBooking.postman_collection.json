    {
      "name": "3. Bookings",
      "item": [
        {
          "name": "Add Booking",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('BOOKING_ID', '');",
                  "if (!pm.collectionVariables.get('CHECK_IN_DATE')) pm.collectionVariables.set('CHECK_IN_DATE', new Date(Date.now()+10*86400000).toISOString());",
                  "",
                  "// Choose an existing hotel automatically when HOTEL_ID is empty.",
                  "if (!pm.variables.get('HOTEL_ID')) {",
                  "  try {",
                  "    const hotels = await pm.sendRequest({",
                  "      url: pm.variables.replaceIn('{{URL}}/api/v1/hotels?limit=1'),",
                  "      method: 'GET'",
                  "    });",
                  "    if (hotels.code !== 200) throw new Error('Cannot load hotels: HTTP ' + hotels.code);",
                  "    const response = hotels.json();",
                  "    const hotelId = response.success === true && Array.isArray(response.data) && response.data[0] && response.data[0]._id;",
                  "    if (typeof hotelId !== 'string' || !/^[a-f0-9]{24}$/i.test(hotelId)) throw new Error('No hotel available. Create a hotel first.');",
                  "    pm.collectionVariables.set('HOTEL_ID', hotelId);",
                  "  } catch (err) {",
                  "    pm.test('Hotel available before creating booking', () => { throw err; });",
                  "    pm.execution.setNextRequest(null);",
                  "    pm.execution.skipRequest();",
                  "  }",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Response below 3 seconds', () => pm.expect(pm.response.responseTime).to.be.below(3000));",
                  "",
                  "// Save the new booking ID, then choose the next request (like VacQ).",
                  "let response;",
                  "try { response = pm.response.json(); } catch (err) {}",
                  "const bookingId = response && response.data && response.data._id;",
                  "const created = pm.response.code === 201 && response && response.success === true && typeof bookingId === 'string' && /^[a-f0-9]{24}$/i.test(bookingId);",
                  "if (created) pm.collectionVariables.set('BOOKING_ID', bookingId);",
                  "",
                  "pm.test('Success response', () => pm.expect(response && response.success).to.be.true);",
                  "pm.test('Save booking ID and validate nights', () => {",
                  "  pm.expect(created).to.be.true;",
                  "  pm.expect(pm.collectionVariables.get('BOOKING_ID')).to.eql(bookingId);",
                  "  pm.expect(response.data.nights).to.eql(JSON.parse(pm.variables.replaceIn(pm.request.body.raw)).nights);",
                  "});",
                  "pm.execution.setNextRequest(created ? 'Get Single Booking' : null);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{TOKEN}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
